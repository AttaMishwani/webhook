// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}


// To migrate this model to your Prisma database, follow these steps:

// 1. Add the model definition (below) to your `prisma/schema.prisma` file if it's not already there:
model InventoryUpdate {
  id             Int      @id @default(autoincrement())
  shop           String
  productId      String
  productTitle   String
  totalInventory Int
  updatedAt      DateTime @default(now())
}

// 2. Save the `prisma/schema.prisma` file.

// 3. In your terminal, run the following Prisma commands to create and apply the migration:
//    npx prisma migrate dev --name add-inventory-update

// 4. This will update your SQLite (or selected) database to include the `InventoryUpdate` table.


model CollectionSortPreference {
  id           String   @id @default(cuid())
  collectionId String   @unique
  sortMode     String
  shop         String
  updatedAt    DateTime @updatedAt
}